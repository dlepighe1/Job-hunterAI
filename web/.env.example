# Copy to .env.local and fill in. .env.local is gitignored, so never commit real keys.
#
# THIS FILE IS TRACKED BY GIT. .gitignore ignores every .env.* except this one, so a real
# key typed here is a key committed to the repository. Put values in .env.local instead;
# Next.js loads that automatically and never loads this file.
#
# Nothing here is required to boot. Every value is read through a getter, so a missing key
# fails only when the feature that needs it is used, and the app runs with none of these set
# and the keyword engine still scores.

# --- Fine-tuned scoring service (Python FastAPI, from the Resume-jd-matcher repo) ---
# http://localhost:8000 for local dev, or your container host URL in production.
# Assumed to be scale-to-zero: the first request after an idle period can take 30-60s,
# and the UI reports that as a waking state rather than a hung spinner.
# Without it: the fine-tuned and base engines are offered as unavailable. Keyword still works.
SCORING_SERVICE_URL=http://localhost:8000

# --- Claude (optional: written feedback, and résumé tailoring) ---
# The only per-call cost in the product. Opt-in per analysis, never a default.
# Powers both the Claude engine and /api/tailor (Elevate). Without it, both say so.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# --- Supabase (persistence) ---
# Without these, `isPersistenceConfigured()` is false: applications, résumés, contacts,
# outreach and the dashboard all report "no database configured" and the matcher still runs.
SUPABASE_URL=
# Server-side only. Never expose the service-role key to the browser: SPEC Part 3 keeps
# RLS on with no permissive policies, so this key is the only thing that can read a row.
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk (identity) ---
# Create an app at https://dashboard.clerk.com, enable Google + email/password only.
# Without these, every route in proxy.ts's protected list 500s, and the matcher stays public.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Dev mode (LOCAL ONLY) ---
# Bypasses sign-in and serves the fixture dataset in lib/dev-fixtures.ts, so every screen can
# be seen populated without Clerk or a provisioned database. An amber banner says so on every
# page while it is on, and nothing is read from or written to Supabase.
#
# Two things to know:
#   1. A PRODUCTION BUILD WITH THIS SET REFUSES TO COMPILE. That is deliberate, see
#      lib/dev-mode.ts. Comment it out before `npm run build`.
#   2. It must be exactly "1". "true", "yes" and " 1" are all treated as off, so it cannot
#      be enabled by a plausible-looking value.
#
# DEV_BYPASS_AUTH=1
